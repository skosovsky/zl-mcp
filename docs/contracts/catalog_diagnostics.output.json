{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "not_attempted",
        "running",
        "exhausted",
        "partial",
        "unsupported"
      ]
    },
    "last_attempt_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_success_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "observed_count": {
      "type": "integer",
      "minimum": 0
    },
    "permitted_count": {
      "type": "integer",
      "minimum": 0
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "short_page",
        "source_unsupported",
        "auth_required",
        "upstream_unavailable",
        "cancelled_or_deadline",
        "oversized_page",
        "storage_or_metadata_error",
        "repeated_page",
        "page_limit"
      ]
    },
    "profiles": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_attempted",
            "running",
            "completed",
            "partial",
            "unsupported"
          ]
        },
        "last_attempt_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_success_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "requested_count": {
          "type": "integer",
          "minimum": 0
        },
        "returned_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_count": {
          "type": "integer",
          "minimum": 0
        },
        "stop_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "known_ids_processed",
            "missing_profiles",
            "source_unsupported",
            "auth_required",
            "upstream_unavailable",
            "cancelled_or_deadline",
            "storage_or_metadata_error",
            "page_limit"
          ]
        }
      },
      "required": [
        "status",
        "last_attempt_at",
        "last_success_at",
        "requested_count",
        "returned_count",
        "missing_count",
        "stop_reason"
      ],
      "additionalProperties": false
    },
    "preload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "not_attempted",
            "running",
            "observed",
            "partial",
            "unsupported"
          ]
        },
        "last_attempt_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_success_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "observed_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "permitted_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "catalog_complete": {
          "const": false
        },
        "messages_imported": {
          "const": false
        },
        "stop_reason": {
          "enum": [
            null,
            "observed_snapshot",
            "source_unsupported",
            "auth_required",
            "invalid_source_page",
            "upstream_unavailable",
            "cancelled_or_deadline",
            "storage_or_metadata_error"
          ]
        }
      },
      "required": [
        "status",
        "last_attempt_at",
        "last_success_at",
        "observed_count",
        "permitted_count",
        "catalog_complete",
        "messages_imported",
        "stop_reason"
      ]
    }
  },
  "required": [
    "status",
    "last_attempt_at",
    "last_success_at",
    "observed_count",
    "permitted_count",
    "stop_reason"
  ],
  "additionalProperties": false
}
