{
  "type": "object",
  "properties": {
    "conversations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "conversation_type": {
            "type": "string",
            "enum": [
              "direct",
              "group"
            ]
          },
          "conversation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadata_source": {
            "type": "string"
          },
          "availability": {
            "type": "string",
            "enum": [
              "member",
              "unknown",
              "observed"
            ]
          },
          "first_discovered_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "collection_enabled": {
            "type": "boolean"
          },
          "aliases": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "friendship": {
            "type": "string",
            "enum": [
              "friend",
              "non_friend",
              "unknown"
            ]
          },
          "has_stored_messages": {
            "type": "boolean"
          },
          "metadata_sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "conversation_type",
          "conversation_id",
          "name",
          "metadata_source",
          "availability",
          "first_discovered_at",
          "updated_at",
          "collection_enabled"
        ],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      }
    },
    "has_more": {
      "type": "boolean"
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "catalog_complete": {
      "const": false
    },
    "catalog_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "group_catalog",
          "live",
          "replay",
          "stored_message",
          "contacts_catalog",
          "preload_catalog",
          "retained_archive"
        ]
      }
    },
    "empty_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "no_discovered_conversations",
        "no_matching_conversations",
        null
      ]
    },
    "source": {
      "$ref": "#/$defs/ArchiveSource"
    }
  },
  "required": [
    "conversations",
    "has_more",
    "next_cursor",
    "catalog_complete",
    "catalog_sources",
    "empty_reason"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ArchiveSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "capture_cache_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "preserved_at": {
          "type": "string",
          "format": "date-time"
        },
        "retention": {
          "const": "until_owner_deletion"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "direct_files": {
          "type": "integer",
          "minimum": 0
        },
        "group_files": {
          "type": "integer",
          "minimum": 0
        },
        "history_complete": {
          "const": false
        },
        "read_scope": {
          "const": "collection_policy"
        }
      },
      "required": [
        "source_id",
        "captured_at",
        "capture_cache_expires_at",
        "preserved_at",
        "retention",
        "digest",
        "file_count",
        "direct_files",
        "group_files",
        "history_complete",
        "read_scope"
      ]
    }
  }
}
