{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "const": "zalo.conversation.message.created"
    },
    "arguments": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "all",
            "direct",
            "group",
            "conversation"
          ]
        },
        "conversation_type": {
          "type": "string",
          "enum": [
            "direct",
            "group"
          ]
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "scope"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "scope": {
              "enum": [
                "all",
                "direct",
                "group"
              ]
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "conversation_type"
                ]
              },
              {
                "required": [
                  "conversation_id"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "scope": {
              "const": "conversation"
            }
          },
          "required": [
            "conversation_type",
            "conversation_id"
          ]
        }
      ]
    },
    "delivery": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "webhook"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 4096
        },
        "secret": {
          "type": "string",
          "minLength": 1,
          "pattern": "^whsec_[A-Za-z0-9+/]+={0,2}$",
          "maxLength": 94
        }
      },
      "required": [
        "mode",
        "url",
        "secret"
      ],
      "additionalProperties": false
    },
    "cursor": {
      "type": "null"
    },
    "ttlMs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 60000,
      "maximum": 2592000000
    },
    "_meta": {
      "type": "object"
    }
  },
  "required": [
    "name",
    "arguments",
    "delivery"
  ],
  "additionalProperties": false
}
