{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "const": "zalo.subscription.journal.ready.v1"
    },
    "arguments": {
      "type": "object",
      "properties": {
        "subscription_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "generation_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "subscription_id",
        "generation_reference"
      ],
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "webhook"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "format": "uri",
          "pattern": "^(https://|http://(127\\.0\\.0\\.1|\\[::1\\]):[1-9][0-9]{0,4}/)",
          "maxLength": 4096
        }
      },
      "required": [
        "mode",
        "url"
      ],
      "additionalProperties": false
    },
    "_meta": {
      "type": "object"
    }
  },
  "required": [
    "name",
    "arguments",
    "delivery"
  ],
  "additionalProperties": false
}
