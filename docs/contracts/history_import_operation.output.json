{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "conversation_type": {
      "enum": [
        "direct",
        "group"
      ]
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "since": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "until": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "notification_policy": {
      "const": "none"
    },
    "source_kind": {
      "enum": [
        "group_cloud",
        "unsupported",
        "conversation_preload",
        "mobile_archive"
      ]
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "paused",
        "completed",
        "partial",
        "cancelled",
        "failed",
        "unsupported"
      ]
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 50
    },
    "max_pages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 20
    },
    "max_messages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000,
      "default": 1000
    },
    "pages_observed": {
      "type": "integer",
      "minimum": 0
    },
    "records_observed": {
      "type": "integer",
      "minimum": 0
    },
    "inserted_count": {
      "type": "integer",
      "minimum": 0
    },
    "duplicate_count": {
      "type": "integer",
      "minimum": 0
    },
    "out_of_interval_count": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "earliest_imported_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "latest_imported_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "source_has_more": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "is_filtered": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "is_filtered_by_phase": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "is_filtered_by_time_join": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "is_old": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "join_timestamp_millis": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,127})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "history_complete": {
      "const": false
    },
    "stop_reason": {
      "enum": [
        null,
        "available_source_exhausted",
        "page_limit",
        "message_limit",
        "time_limit",
        "missing_continuation",
        "repeated_cursor",
        "empty_continuing_page",
        "source_filtered",
        "auth_required",
        "source_unsupported",
        "upstream_unavailable",
        "invalid_source_page",
        "storage_error",
        "cancelled",
        "access_revoked",
        "source_window_limited",
        "source_gaps",
        "source_unavailable"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "conversation_preload",
        "mobile_archive"
      ]
    },
    "mobile_coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "examined": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "expired": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported_types": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported_content": {
          "type": "integer",
          "minimum": 0
        },
        "missing_metadata": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_metadata": {
          "type": "integer",
          "minimum": 0
        },
        "deferred_controls": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_metadata_fields": {
          "type": "integer",
          "minimum": 0
        },
        "expired_quotes": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_quotes": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_mentions": {
          "type": "integer",
          "minimum": 0
        },
        "source_rows": {
          "type": "integer",
          "minimum": 0
        },
        "period_rows": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_timestamp_rows": {
          "type": "integer",
          "minimum": 0
        },
        "own_recalls": {
          "type": "integer",
          "minimum": 0,
          "description": "Verified own-direct control rows examined in the requested period; whole-source applied targets are counted separately in source_recalls."
        },
        "source_controls": {
          "type": "integer",
          "minimum": 0,
          "description": "Frozen whole-file control count; all controls must be verified before the first page commits."
        },
        "source_recalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000,
          "description": "Whole-source own-direct tombstones applied by the control prelude, independent of the requested message period."
        },
        "control_prelude_complete": {
          "type": "boolean",
          "description": "Whole-source control proof and tombstones committed before ordinary message paging."
        }
      },
      "required": [
        "examined",
        "rejected",
        "expired",
        "unsupported_types",
        "unsupported_content",
        "missing_metadata",
        "invalid_metadata",
        "deferred_controls",
        "unknown_metadata_fields",
        "expired_quotes",
        "unresolved_quotes",
        "unresolved_mentions",
        "source_rows",
        "period_rows",
        "invalid_timestamp_rows"
      ]
    }
  },
  "required": [
    "operation_id",
    "request_id",
    "conversation_type",
    "conversation_id",
    "since",
    "until",
    "notification_policy",
    "source_kind",
    "state",
    "page_size",
    "max_pages",
    "max_messages",
    "pages_observed",
    "records_observed",
    "inserted_count",
    "duplicate_count",
    "out_of_interval_count",
    "created_at",
    "updated_at",
    "earliest_imported_at",
    "latest_imported_at",
    "source_has_more",
    "is_filtered",
    "is_filtered_by_phase",
    "is_filtered_by_time_join",
    "is_old",
    "join_timestamp_millis",
    "history_complete",
    "stop_reason"
  ]
}
