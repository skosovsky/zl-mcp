{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sender_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sender_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "text": {
      "type": "string",
      "maxLength": 2048
    },
    "text_truncated": {
      "type": "boolean"
    },
    "text_resource_uri": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "maxLength": 4096
    }
  },
  "required": [
    "group_id",
    "message_id",
    "sender_id",
    "sender_name",
    "sent_at",
    "text",
    "text_truncated",
    "text_resource_uri"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "text_truncated": {
            "const": true
          }
        },
        "required": [
          "text_truncated"
        ]
      },
      "then": {
        "properties": {
          "text_resource_uri": {
            "type": "string",
            "format": "uri",
            "pattern": "^zalo://groups/",
            "maxLength": 4096
          }
        }
      }
    }
  ]
}
