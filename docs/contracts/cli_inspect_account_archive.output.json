{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "description": "Owner-only safe receipt for a retained account export. Storage does not establish history completeness or import any records.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "const": "account"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "direct_files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "group_files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "stored_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 538000000
        },
        "history_complete": {
          "const": false
        },
        "import_performed": {
          "const": false
        }
      },
      "required": [
        "source_id",
        "scope",
        "captured_at",
        "expires_at",
        "digest",
        "file_count",
        "direct_files",
        "group_files",
        "stored_bytes",
        "history_complete",
        "import_performed"
      ]
    },
    "since": {
      "type": "string",
      "format": "date-time"
    },
    "until": {
      "type": "string",
      "format": "date-time"
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "has_more_files": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file_index": {
            "type": "integer",
            "minimum": 0
          },
          "conversation_type": {
            "enum": [
              "direct",
              "group"
            ]
          },
          "status": {
            "enum": [
              "available",
              "unreadable_sqlite"
            ]
          },
          "source_rows": {
            "type": "integer",
            "minimum": 0
          },
          "period_rows": {
            "type": "integer",
            "minimum": 0
          },
          "invalid_timestamp_rows": {
            "type": "integer",
            "minimum": 0
          },
          "source_earliest_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "source_latest_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "wal_mode": {
            "type": "boolean"
          },
          "examined": {
            "type": "integer",
            "minimum": 0
          },
          "rejected": {
            "type": "integer",
            "minimum": 0
          },
          "source_controls": {
            "type": "integer",
            "minimum": 0
          },
          "sample_has_more": {
            "type": "boolean"
          },
          "sample_content_kinds": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            },
            "propertyNames": {
              "enum": [
                "webchat",
                "chat.doodle",
                "chat.photo",
                "chat.voice",
                "chat.sticker",
                "chat.recommended",
                "chat.list.action",
                "chat.location.new",
                "chat.video.msg",
                "share.file",
                "chat.gif",
                "chat.webcontent",
                "chat.webcontent.v2",
                "unsupported"
              ]
            }
          },
          "metadata_diagnostics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rows_with_metadata": {
                "type": "integer",
                "minimum": 0
              },
              "missing_metadata": {
                "type": "integer",
                "minimum": 0
              },
              "invalid_metadata": {
                "type": "integer",
                "minimum": 0
              },
              "attachment_count": {
                "type": "integer",
                "minimum": 0
              },
              "unsupported_metadata_fields": {
                "type": "integer",
                "minimum": 0
              },
              "source_text_present": {
                "type": "integer",
                "minimum": 0
              },
              "title_present": {
                "type": "integer",
                "minimum": 0
              },
              "title_equals_source_text": {
                "type": "integer",
                "minimum": 0
              },
              "action_classes": {
                "type": "object",
                "propertyNames": {
                  "enum": [
                    "absent",
                    "empty",
                    "rtf",
                    "ecard",
                    "text",
                    "plain",
                    "webchat",
                    "other"
                  ]
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "action_shapes": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "byte_length": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "utf8_valid": {
                      "type": "boolean"
                    },
                    "contains_nul": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "sha256",
                    "byte_length",
                    "utf8_valid",
                    "contains_nul"
                  ]
                }
              },
              "action_shapes_truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "rows_with_metadata",
              "missing_metadata",
              "invalid_metadata",
              "attachment_count",
              "unsupported_metadata_fields",
              "source_text_present",
              "title_present",
              "title_equals_source_text",
              "action_classes",
              "action_shapes",
              "action_shapes_truncated"
            ]
          }
        },
        "required": [
          "file_index",
          "conversation_type",
          "status",
          "source_rows",
          "period_rows",
          "invalid_timestamp_rows",
          "source_earliest_at",
          "source_latest_at",
          "wal_mode",
          "examined",
          "rejected",
          "source_controls",
          "sample_has_more",
          "sample_content_kinds"
        ]
      }
    },
    "download_performed": {
      "const": false
    },
    "import_performed": {
      "const": false
    },
    "history_complete": {
      "const": false
    }
  },
  "required": [
    "manifest",
    "since",
    "until",
    "offset",
    "has_more_files",
    "files",
    "download_performed",
    "import_performed",
    "history_complete"
  ]
}
