{
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier"
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier"
    },
    "before": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20,
      "default": 5
    },
    "after": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20,
      "default": 5
    },
    "conversation_type": {
      "type": "string",
      "enum": [
        "direct",
        "group"
      ]
    },
    "coverage_mode": {
      "type": "string",
      "enum": [
        "full",
        "compact"
      ],
      "default": "full",
      "description": "full preserves complete known_gaps (default). compact returns no inline gaps, exact snapshot count and explicit coverage_details continuation for zalo_list_coverage_gaps; request compact to keep large coverage within response budget."
    }
  },
  "required": [
    "conversation_id",
    "message_id",
    "conversation_type"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
