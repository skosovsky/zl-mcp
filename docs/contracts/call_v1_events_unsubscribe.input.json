{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "const": "zalo.conversation.call.observed.v1"
    },
    "arguments": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "direct",
            "conversation"
          ]
        },
        "conversation_type": {
          "type": "string",
          "enum": [
            "direct"
          ]
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "direction": {
          "enum": [
            "incoming",
            "outgoing",
            "all"
          ],
          "default": "all"
        }
      },
      "required": [
        "scope"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "scope": {
              "enum": [
                "direct"
              ]
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "conversation_type"
                ]
              },
              {
                "required": [
                  "conversation_id"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "scope": {
              "const": "conversation"
            }
          },
          "required": [
            "conversation_type",
            "conversation_id"
          ]
        }
      ]
    },
    "delivery": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "webhook"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "format": "uri",
          "pattern": "^(https://|http://(127\\.0\\.0\\.1|\\[::1\\]):[1-9][0-9]{0,4}/)",
          "maxLength": 4096
        }
      },
      "required": [
        "mode",
        "url"
      ],
      "additionalProperties": false
    },
    "_meta": {
      "type": "object"
    }
  },
  "required": [
    "name",
    "arguments",
    "delivery"
  ],
  "additionalProperties": false
}
