{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Offline bounded per-file coverage diagnostics. No message bodies, import or network requests.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "method": {
      "const": "cli_inspect_account_archive"
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "since": {
          "type": "string",
          "format": "date-time"
        },
        "until": {
          "type": "string",
          "format": "date-time"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        }
      },
      "required": [
        "source_id",
        "since",
        "until"
      ]
    }
  },
  "required": [
    "method",
    "arguments"
  ]
}
