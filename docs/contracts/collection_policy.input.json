{
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "all",
        "selected"
      ]
    },
    "conversations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "direct",
              "group"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "type",
          "id"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true,
      "maxItems": 10000
    }
  },
  "required": [
    "mode"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "all"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "conversations"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "selected"
          }
        }
      },
      "then": {
        "required": [
          "conversations"
        ]
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
