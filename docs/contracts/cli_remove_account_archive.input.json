{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Owner-only explicit removal of a retained source. No phone request or corpus deletion.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "method": {
      "const": "cli_remove_account_archive"
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "source_id"
      ]
    }
  },
  "required": [
    "method",
    "arguments"
  ]
}
