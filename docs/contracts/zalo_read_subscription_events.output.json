        "null"
      ],
      "maxLength": 64,
      "description": "Closed safe continuation category, never raw storage/HTTP errors.",
      "enum": [
        null,
        "not_configured",
        "accepted",
        "pending_delivery",
        "awaiting_ack",
        "callback_gone",
        "payload_too_large",
        "http_rejected",
        "attempts",
        "deadline",
        "episode_expired",
        "access_revoked",
        "subscription_inactive",
        "generation_changed",
        "head_changed",
        "acknowledged",
        "capacity",
        "unknown"
      ]
    },
    "readiness_mode": {
      "const": "persisted",
      "description": "Explicit processing view; HTTP transport completion is independent."
    }
  },
  "required": [
    "subscription_id",
    "events",
    "has_more",
    "blocked_on_delivery"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "readiness_mode"
        ]
      },
      "then": {
        "properties": {
          "blocked_on_delivery": {
            "const": false
          },
          "events": {
            "items": {
              "required": [
                "processing_state"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "events": {
            "items": {
              "properties": {
                "delivery_state": {
                  "enum": [
                    "delivered",
                    "failed",
                    "cancelled",
                    "pruned"
                  ]
                },
                "processing_state": false
              }
            }
          }
        }
      }
    }
  ]
}
