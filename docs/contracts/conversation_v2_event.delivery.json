{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "name": {
      "const": "zalo.conversation.message.created.v2"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sender_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sender_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "sent_at": {
          "type": "string",
          "format": "date-time"
        },
        "text": {
          "type": "string",
          "maxLength": 2048
        },
        "text_truncated": {
          "type": "boolean"
        },
        "text_resource_uri": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 4096
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "conversation_type": {
          "type": "string",
          "enum": [
            "direct",
            "group"
          ]
        },
        "conversation_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "schema_version": {
          "const": 2
        },
        "direction": {
          "enum": [
            "incoming",
            "outgoing",
            "unknown"
          ]
        },
        "first_incoming": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "conversation_id",
        "message_id",
        "sender_id",
        "sender_name",
        "sent_at",
        "text",
        "text_truncated",
        "text_resource_uri",
        "conversation_type",
        "conversation_name",
        "schema_version",
        "direction",
        "first_incoming"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "text_truncated": {
                "const": true
              }
            },
            "required": [
              "text_truncated"
            ]
          },
          "then": {
            "properties": {
              "text_resource_uri": {
                "type": "string",
                "format": "uri",
                "pattern": "^zalo://conversations/(direct|group)/",
                "maxLength": 4096
              }
            }
          }
        }
      ]
    },
    "cursor": {
      "type": "null"
    }
  },
  "required": [
    "eventId",
    "name",
    "timestamp",
    "data",
    "cursor"
  ],
  "additionalProperties": false
}
