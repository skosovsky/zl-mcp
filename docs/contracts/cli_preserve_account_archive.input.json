{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Planned owner-only promotion of an existing encrypted account source to durable local storage. Does not dispatch synchronization or enable public MCP access.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "method": {
      "const": "cli_preserve_account_archive"
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "retention": {
          "const": "until_owner_deletion"
        }
      },
      "required": [
        "source_id",
        "retention"
      ]
    }
  },
  "required": [
    "method",
    "arguments"
  ]
}
