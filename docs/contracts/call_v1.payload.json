{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "conversation_type": {
      "enum": [
        "direct",
        "group"
      ]
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "conversation_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "actor_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "direction": {
      "enum": [
        "incoming",
        "outgoing",
        "unknown"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "identity_basis": {
      "enum": [
        "upstream_action_id",
        "observed_fingerprint"
      ]
    },
    "source": {
      "enum": [
        "live",
        "replay"
      ]
    },
    "native_type": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "family": {
      "const": "call"
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "status": {
          "enum": [
            "unknown",
            "started",
            "ringing",
            "answered",
            "ended",
            "missed",
            "cancelled",
            "declined"
          ]
        },
        "native_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "mode": {
          "enum": [
            "voice",
            "video",
            "unknown"
          ]
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "call_id",
        "status",
        "native_status",
        "mode",
        "duration_ms"
      ]
    }
  },
  "required": [
    "schema_version",
    "conversation_type",
    "conversation_id",
    "conversation_name",
    "actor_id",
    "actor_name",
    "occurred_at",
    "direction",
    "source_id",
    "identity_basis",
    "source",
    "native_type",
    "family",
    "call"
  ]
}
