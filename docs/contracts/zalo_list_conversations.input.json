{
  "type": "object",
  "properties": {
    "conversation_type": {
      "type": "string",
      "enum": [
        "direct",
        "group"
      ]
    },
    "query": {
      "type": "string",
      "maxLength": 500
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 20
    },
    "cursor": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "format": "uuid",
      "description": "Select an immutable retained archive from zalo_list_archive_sources. Omit for the current local corpus. No automatic acquisition or source fallback."
    }
  },
  "required": [],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
