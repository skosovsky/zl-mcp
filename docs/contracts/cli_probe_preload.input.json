{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "method": {
      "const": "cli_probe_preload"
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conversation_type": {
          "enum": [
            "direct",
            "group"
          ]
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "dependentRequired": {
        "conversation_type": [
          "conversation_id",
          "message_id"
        ],
        "conversation_id": [
          "conversation_type",
          "message_id"
        ],
        "message_id": [
          "conversation_type",
          "conversation_id"
        ]
      }
    }
  },
  "required": [
    "method",
    "arguments"
  ],
  "additionalProperties": false
}
