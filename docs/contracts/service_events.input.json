{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["local_callback_urls"],
  "properties": {
    "local_callback_urls": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^https?://(127\\.0\\.0\\.1|\\[::1\\]):[1-9][0-9]{0,4}/"
      }
    }
  }
}
