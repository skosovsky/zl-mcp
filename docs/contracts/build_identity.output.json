{
 "type":"object",
 "description":"Value of CallToolResult._meta[\"zl-mcp/build\"]. Does not modify strict successful output DTOs or stored operation outcomes.",
 "properties":{
  "backend":{"$ref":"#/$defs/identity"},
  "bridge":{"$ref":"#/$defs/identity"}
 },
 "required":["backend"],
 "additionalProperties":false,
 "$defs":{
