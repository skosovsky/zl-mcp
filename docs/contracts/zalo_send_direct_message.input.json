{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "recipient_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[\\s\\S]*\\S[\\s\\S]*$"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "reply_to_message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "recipient_id",
    "text",
    "request_id"
  ],
  "additionalProperties": false
}
