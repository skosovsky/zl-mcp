{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "subscription_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "include_diagnostics": {
      "type": "boolean",
      "default": false,
      "description": "Opt in to safe delivery reasons, stable diagnostic references and retry hints. Omitted/false preserves the legacy result shape."
    }
  },
  "required": [
    "subscription_id"
  ],
  "additionalProperties": false
}
