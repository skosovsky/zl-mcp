{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "conversation_type": {
      "type": "string",
      "enum": [
        "direct",
        "group"
      ]
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "message_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  },
  "required": [
    "request_id",
    "conversation_type",
    "conversation_id",
    "message_ids"
  ],
  "description": "Explicit read receipt for 1\u201350 retained incoming messages in one exact chat. Native chat watermark effects may include earlier messages; no promise of per-message isolation. No automatic use from reads, Events or journal acknowledgement."
}
