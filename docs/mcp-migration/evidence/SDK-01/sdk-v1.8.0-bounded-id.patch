+// Copyright 2026 The Go MCP SDK Authors. All rights reserved.
+// Use of this source code is governed by the license
+// that can be found in the LICENSE file.
+
+package jsonrpc2_test
+
+import (
+	"encoding/json"
+	"errors"
+	"github.com/modelcontextprotocol/go-sdk/internal/jsonrpc2"
+	"math"
+	"strings"
+	"testing"
+)
+
+func TestSDK01NumericBudget(t *testing.T) {
+	// Arrange: accepted mathematical zero at the exact token bound, then one byte over.
+	boundary := "0." + strings.Repeat("0", 1022)
+	for _, tc := range []struct {
+		value string
+		valid bool
+	}{
+		{boundary, true}, {boundary + "0", false}, {"1e100000000", false}, {"1e-100000000", false},
+		{"0e999999999", true}, {"9223372036854775807.0", true}, {"-9223372036854775808.0", true},
+		{"9223372036854775808.0", false}, {"-9223372036854775809.0", false},
+	} {
+		// Act.
+		_, err := jsonrpc2.MakeID(json.Number(tc.value))
+		// Assert.
+		if (err == nil) != tc.valid {
+			t.Errorf("length%d valid%v error%v", len(tc.value), tc.valid, err)
+		}
+	}
+}
+
+func TestSDK01FloatAdmission(t *testing.T) {
+	for _, v := range []float64{1.5, math.NaN(), math.Inf(1), math.Inf(-1), 0x1p63, -0x1p64} {
+		// Arrange/Act.
+		_, err := jsonrpc2.MakeID(v)
+		// Assert.
+		if !errors.Is(err, jsonrpc2.ErrParse) {
+			t.Errorf("invalid float %v accepted", v)
+		}
+	}
+}
+
+func TestSDK01NullIDError(t *testing.T) {
+	// Arrange.
+	response := &jsonrpc2.Response{Error: jsonrpc2.ErrInvalidRequest}
+	// Act.
+	raw, err := jsonrpc2.EncodeMessage(response)
+	var envelope map[string]json.RawMessage
+	if err == nil {
+		err = json.Unmarshal(raw, &envelope)
+	}
+	// Assert.
+	if err != nil || string(envelope["id"]) != "null" {
+		t.Fatalf("response %s error%v", raw, err)
+	}
+}
