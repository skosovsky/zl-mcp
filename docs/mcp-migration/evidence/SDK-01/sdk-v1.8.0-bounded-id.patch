+func (x *CancelledParams) UnmarshalJSON(data []byte) error {
+	type plain CancelledParams
+	wire := struct {
+		*plain
+		RequestID json.RawMessage `json:"requestId"`
+	}{plain: (*plain)(x)}
+	if err := internaljson.Unmarshal(data, &wire); err != nil {
