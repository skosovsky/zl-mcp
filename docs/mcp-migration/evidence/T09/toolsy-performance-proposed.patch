+
+// cloneInterface avoids allocating reflect interface holders for ordinary JSON
+// containers. Unknown BYOT values keep the same reflection fallback and memo.
+func (c *valueCloner) cloneInterface(value any) any {
+	cloned := c.clone(reflect.ValueOf(value))
+	if !cloned.IsValid() {
+		return nil
+	}
+	return cloned.Interface()
+}
