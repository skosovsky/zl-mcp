{
  "_meta": {
    "io.modelcontextprotocol/serverInfo": {
      "name": "zl-mcp",
      "version": "build-identity-tested-separately"
    }
  },
  "cacheScope": "public",
  "resourceTemplates": [
    {
      "mimeType": "application/json",
      "name": "Full local archive record",
      "uriTemplate": "zalo://archives/{token}"
    },
    {
      "mimeType": "text/plain",
      "name": "Local conversation message",
      "uriTemplate": "zalo://conversations/{conversation_type}/{conversation_id}/messages/{message_id}"
    },
    {
      "mimeType": "application/json",
      "name": "Local message content metadata",
      "uriTemplate": "zalo://conversations/{conversation_type}/{conversation_id}/messages/{message_id}/content"
    },
    {
      "mimeType": "text/plain",
      "name": "Local Zalo message",
      "uriTemplate": "zalo://groups/{group_id}/messages/{message_id}"
    }
  ],
  "resultType": "complete",
  "ttlMs": 0
}
