{
  "_meta": {
    "io.modelcontextprotocol/serverInfo": {
      "name": "zl-mcp",
      "version": "build-identity-tested-separately"
    }
  },
  "cacheScope": "public",
  "resources": [
    {
      "mimeType": "text/plain",
      "name": "Zalo local corpus capabilities",
      "uri": "zalo://capabilities"
    },
    {
      "mimeType": "application/json",
      "name": "Contact catalogue source diagnostics",
      "uri": "zalo://catalog/diagnostics"
    },
    {
      "description": "Read finite reaction codes and names without changing Zalo state.",
      "mimeType": "application/json",
      "name": "Explicit reaction choices",
      "uri": "zalo://catalog/reactions"
    },
    {
      "mimeType": "application/json",
      "name": "Conversation collection status",
      "uri": "zalo://collection"
    },
    {
      "mimeType": "application/json",
      "name": "MCP Events delivery diagnostics",
      "uri": "zalo://events/diagnostics"
    }
  ],
  "resultType": "complete",
  "ttlMs": 0
}
